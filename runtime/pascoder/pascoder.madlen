C 044-055: masks and constants.
 CHKW:,LOG,0000101010101010
 GETW:,LOG,0000070707070707
 CHKL:,LOG,0000101000000000
 GETL:,LOG,0000070700000000
 GETSTK:,LOG,0000070707070700
 ONE:,LOG,0000000000000001
 MASK15:,LOG,0000000000077777
 DIGITS:,GOST,6H777777
 OFFFMT:,LOG,0000040701603400
 NEXT:,LOG,0000010000000001
C 056-061: writable scratch words; octal offsets retained in code.
 FIRST:,BSS,1
 PAGE:,BSS,1
 OVRSTK:,BSS,1
 LAST:,BSS,1
C 062-063: E64 descriptor; M1 points at a success or error message.
 PRINFO:,LOG,0400000004000000
 PRFMT:,LOG,0000000044000000
C 064-114: GOST messages and writable fields in the success message.
 OKTEXT:,GOST,6H'175'--> Г
 ,GOST,6HП ЗАПИ
 ,GOST,6HСАНА В
 ,GOST,6H ЗОНЫ 
 BEGNO:,BSS,1
 ,GOST,6H:0000-
 ENDNO:,BSS,1
 TAIL:,GOST,6H:0000 
 ,GOST,6H<-- '172' 
 ERRW:,GOST,6H! ОШИБ
 ,GOST,6HКА В У
 ,GOST,6HКАЗАТЕ
 ,GOST,6HЛЕ ЗАП
 ,GOST,6HИСИ !'172'
 ERRL:,GOST,6H! ОШИБ
 ,GOST,6HКА В О
 ,GOST,6HГРАНИЧ
 ,GOST,6HИТЕЛЕ 
 ,GOST,6HЗАПИСИ
 ,GOST,6H !'172'   
 ERRN:,GOST,6H! МАЛО
 ,GOST,6H ЗОН Д
 ,GOST,6HЛЯ ЗАП
 ,GOST,6HИСИ ГП
 ,GOST,6H !'172'   
C Fill the module to 01000 words; the next module starts on a page.
 PAD:,BSS,663B
 ,END,
