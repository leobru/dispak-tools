АРФА	СТАРТ	'1'
	Б
	М
**********
* АРФА - диалоговая программа работы с архивом (версия от 14.12.88).
* Зона 2113/1707, загружается в адреса 0-1777 так же, как КОКА и ПРОРВА
* (Э70 по слову 2, продолжение с ячейки 2). Работает с терминала: читает
* строку-директиву, разбирает её, собирает блок запроса rq и параметр
* yparm и обращается к архиву экстракодом Э63 (A = КЛЮЧАР, РМР = yparm,
* адрес - rq; код ответа - в М16, 0 - норма). Ответ печатается на
* терминал.
*
* Директива: КОМ[...] [имя][: ]ключ=значение,ключ=значение,...
* КОМ - первые три буквы (cmdtab), остальные буквы слова не важны. Ключ
* - одна буква (keytab), после неё до '=' или ':' могут идти любые
* буквы. '*' среди параметров ставит star (для СВЕ - печатать всё).
* КОН кончает работу. Слово таблицы cmdtab: разряды 24-1 - три буквы,
* 25-43 - разрешённые ключи (разряд 25+k для k-го ключа keytab),
* 47 - у директивы есть ответ (печать по rtab), 48 - имени нет.
*
* Номер директивы в таблице (1-32) идёт в разряды 48-43 слова rq; с
* 27-й (ВНБ) к нему прибавляется 22. Ключи Ч и З не реализованы
* (keyerr). Значения ключей пишутся в rq или yparm (см. kN...kK).
*
* Модуль терминала (01540-01775: input, output) имеет свои константы.
* Строки - по 8 разрядов на символ, 0377 - конец строки; текст для
* type кончается словом -1.
*
* Имена придуманы. Разряды нумеруются справа от 1, числа восьмеричные
* там, где они записаны в кавычках или так сказано.
**********
	конд	п'АRFА  '
*
* Начало: Э70 по слову 2 прочитала зону, работа идёт отсюда.
start	ржа	'7'
	пб	begin
*
* type: печать текста с (М1) до слова -1 на терминал, возврат по М15.
* A = 0 - напечатано, иначе пользователь прервал вывод (ответ на
* ИДТИ?); после вызова стоит пе prompt.
type	уиа	(М16)
	пб	output
*
* Таблица директив: слово на директиву (см. шапку), конец - 0 (cmdend).
* 1 НОВ  2 УБР  3 СМЕ  4 ПРА  5 ПАР  6 КТО  7 СВЕ  8 КТЛ
* 9 КАТ 10 ДАЙ 11 ИМЯ 12 СДВ 13 ЗСД 14 АДМ 15 СМА 16 БЮД
* 17 РЕС 18 ГРУ 19 УНБ 20 ЗБЮ 21 УНО 22 АСМ 23 ШИФ 24 ЕNQ
* 25 DЕQ 26 ДЛИ 27 ВНБ 28 ФОТ 29 УНТ 30 РЕЗ 31 ХХХ 32 ОСВ
* Коды 061-066 (ВНБ...ОСВ) ОС выполняет в НЕРЕЗЕ (СПЕЦЭК). ХХХ (065) -
* чтение зоны каталога архива в лист задачи (ключей нет, из диалога
* зону не задать). ОСВ (066) N=n - по-видимому, снятие захватов ЭВМ n
* со всех областей каталога. ФОТ (062) в ОС не реализована.
cmdtab	конд	м24в'00404410'п'НОВ'
	конд	м24в'00000004'п'УБР'
	конд	м24в'00000225'п'СМЕ'
	конд	м24в'00001007'п'ПРА'
	конд	м24в'00000025'п'ПАР'
	конд	м24в'20000005'п'КТО'
	конд	м24в'20000001'п'СВЕ'
	конд	м24в'20000102'п'КТЛ'
	конд	м24в'20000000'п'КАТ'
	конд	м24в'01000021'п'ДАЙ'
	конд	м24в'20000001'п'ИМЯ'
	конд	м24в'00000011'п'СДВ'
	конд	м24в'20000001'п'ЗСД'
	конд	м24в'60000042'п'АДМ'
	конд	м24в'40000142'п'СМА'
	конд	м24в'40000102'п'БЮД'
	конд	м24в'40040012'п'РЕС'
	конд	м24в'40020002'п'ГРУ'
	конд	м24в'40000002'п'УНБ'
	конд	м24в'60000002'п'ЗБЮ'
	конд	м24в'00000000'п'УНО'
	конд	м24в'00000221'п'АСМ'
	конд	м24в'60000002'п'ШИФ'
	конд	м24в'00012001'п'ЕNQ'
	конд	м24в'00000001'п'DЕQ'
	конд	м24в'00000011'п'ДЛИ'
	конд	м24в'40064010'п'ВНБ'
	конд	м24в'00000000'п'ФОТ'
	конд	м24в'40004000'п'УНТ'
	конд	м24в'40004010'п'РЕЗ'
	конд	м24в'00000000'п'ХХХ'
	конд	м24в'40000001'п'ОСВ'
cmdend	пам	1
*
* Таблица ключей: пб на разбор значения, в правом полуслове - буква
* ключа: N Ш П L Д К А Н Т Р М Б У Г В Ч З И С (N и L латинские).
* Переход сюда - пе keytab-1(М15) из keychk; конец таблицы - ktend.
keytab	пб	kN
	конк	в'105'	N
	пб	kSH
	конк	в'70'	Ш
	пб	kP
	конк	в'57'	П
	пб	kL
	конк	в'104'	L
	пб	kD
	конк	в'44'	Д
	пб	kK
	конк	в'52'	К
	пб	kA
	конк	в'40'	А
	пб	kH
	конк	в'55'	Н
	пб	kT
	конк	в'62'	Т
	пб	kR
	конк	в'60'	Р
	пб	kM
	конк	в'54'	М
	пб	kB
	конк	в'41'	Б
	пб	kU
	конк	в'63'	У
	пб	kG
	конк	в'43'	Г
	пб	kV
	конк	в'42'	В
	пб	keyerr
	конк	в'67'	Ч
	пб	keyerr
	конк	в'47'	З
	пб	kI
	конк	в'50'	И
	пб	kS
	конк	в'61'	С
ktend	пам	1
*
* Константы E48...E1: разряд n в слове En.
E48	конд	м40в'200'
E47	конд	м40п'F'
E46	конд	м40п'А'
E45	конд	м40в'020'
E44	конд	м40п'8'
E43	конд	м40п'4'
E42	конд	м40п'2'
E41	конд	м40п'1'
E40	конд	в'0010000000000000'
E39	конд	п'F0000'
E38	конд	п'А0000'
E37	конд	в'0001000000000000'
E36	конд	п'80000'
E35	конд	п'40000'
E34	конд	п'20000'
E33	конд	п'10000'
E32	конд	в'0000020000000000'
E31	конд	п'F000'
E30	конд	п'А000'
E29	конд	в'0000002000000000'
E28	конд	п'8000'
E27	конд	п'4000'
E26	конд	п'2000'
E25	конд	п'1000'
E24	конд	в'40000000'
E23	конд	п'F00'
E22	конд	п'А00'
E21	конд	в'04000000'
E20	конд	п'800'
E19	конд	п'400'
E18	конд	п'200'
E17	конд	п'100'
E16	конд	в'00100000'
E15	конд	п'F0'
E14	конд	п'А0'
E13	конд	в'00010000'
E12	конд	п'80'
E11	конд	п'40'
E10	конд	п'20'
E9	конд	п'10'
E8	конд	в'200'
E7	конд	п'F'
E6	конд	п'А'
E5	конд	в'020'
E4	конд	п'8'
E3	конд	п'4'
E2	конд	п'2'
E1	конд	п'1'
*
* Рабочие ячейки разбора. word - набранное слово (имя директивы, ключ),
* yparm - параметр Э63 (РМР), star - E1, если был '*', num -
* восьмеричное число, keych - текущий ключ, pctmp - для putc.
word	пам	1
yparm	пам	1
star	пам	1
num	пам	1
keych	пам	1
pctmp	пам	1
*
* rq2hd - слово 0 второго запроса (КАТ: сведения о каждой области),
* d211, d251 - адреса ответа ans и запроса rq2 как значения РМР.
rq2hd	конд	м40п'М'
d7	конд	п'7'
*
* blank - маска для рзб: двоичные цифры по 4 разряда превращаются в
* символы-цифры (пробел 017 там, где разряды маски равны 1).
blank	конд	п'      '
d211	конд	в'211'
d251	конд	в'251'
*
* Строка ответа ЗБЮ (РЕЗ-Д, Н/Р, РЕЗ-Л).
gline	пам	1
	пам	1
	пам	1
	пам	1
	пам	1
*
* Блок запроса Э63. rq: разряды 48-43 - номер директивы, E4 - есть
* имя, остальное - значения ключей; rqname - имя (8 разрядов на
* символ, конец 0377) или ключ К.
rq	пам	1
rqname	пам	15
*
* Ответ архива (до 0100 слов), затем второй блок запроса rq2.
ans	пам	1
	пам	1
	пам	1
	пам	1
	пам	1
	пам	4
	пам	1
	пам	1
	пам	2
	пам	19
rq2	пам	1
	пам	29
*
* Ячейки decnum (dcres - также последнее слово ans).
dctmp	пам	1
dcres	пам	1
*
* Строка элемента каталога (КТЛ, КАТ).
oline	пам	1
	пам	1
	пам	1
	конд	в'-1'
*
* Последний прочитанный символ.
ch	пам	1
*
* Строки ответов: слово -1 кончает текст, пустые слова заполняются
* перед печатью. dots - символы 0143 (заполнитель), tacc - права.
tadm	пам	1
	конд	п'  АДМ.'
	пам	1
neg1	конд	в'-1'
tshift	конд	п'СДВИГ '
	конд	п'      '
	пам	1
	конд	в'-1'
tcrea	конд	п'СОЗДАЛ'
dots	конд	в'3066154330661417'
	пам	1
	конд	в'-1'
towner	конд	п'ХОЗЯИН'
	конд	п'  'м40в'143'м32в'143'м24в'143'м16в'143'
	пам	1
	конд	в'-1'
	пам	1
	конд	в'3066154330607417'
	пам	1
	конд	в'-1'
tother	конд	п'ПРОЧИЕ'
	конд	п'  'м40в'143'м32в'143'м24в'143'м16в'143'
	пам	1
	конд	в'-1'
	пам	1
	конд	в'0760754330661543'
tgrps	конд	п'ГРУППЫ'
	конд	п'    00'
	конд	п'      '
	конд	м40в'377'м32в'377'м24в'377'м16в'377'м8в'377'в'377'
trez	конд	п'РЕЗ-Д:'
	конд	п'Н/Р  :'
	конд	п'РЕЗ-Л:'
	конд	п'ДЛИНА '
	пам	1
	конд	в'-1'
tgroup	конд	п'ГРУППА'
	пам	1
tind	конд	в'1202644403407777'
	конд	в'0360741702405377'
*
* Символы и маски.
comma	конд	п','
space	конд	п' '
equal	конд	п'='
msk12	конд	в'00007777'
eol	конд	в'377'
msk5	конд	п':'
d5	конд	п'5'
d5l	конд	п'5000'
msk6	конд	п'D'
left	конд	м24в'77777777'
msk15l	конд	м24в'77777'
d3	конд	п'3'
msk16	конд	в'00177777'
msk24	конд	в'77777777'
*
* Шапка: *** АRFА *** ВЕРСИЯ ОТ 14.12.88.
tvers	конд	в'0621443103607440'
	конд	п' R F А'
	конд	п'  *** '
	конд	п'  ВЕРС'
	конд	п'ИЯ ОТ '
	конд	п'14.12.'
	конд	п'8800  'м24в'214'м16в'377'
*
* getc: следующий символ строки (М1 - слово, М2 - сдвиг 40...0) в ch и
* в A; возврат по М15.
getc	сч	(М1)
	сда	64(М2)
	и	eol
	зп	ch
	пино	getc1(М2)
	уиа	48(М2)
	слиа	1(М1)
getc1	слиа	-8(М2)
	пб	(М15)
*
* putc: символ из A в слово (М3) со сдвигом М4 (-40...0); возврат по
* М15.
putc	сда	64(М4)
	зп	pctmp
	сч	eol
	сда	64(М4)
	и	(М3)
	нтж	(М3)
	или	pctmp
	зп	(М3)
	пино	putc1(М4)
	слиа	1(М3)
	уиа	-48(М4)
putc1	слиа	8(М4)
	пб	(М15)
*
* octnm: восьмеричное число из символов строки до первого не-цифры;
* octch - первый символ уже в A. Результат в A, возврат по М14.
octnm	сч	
octlp	зп	num
	пв	getc(М15)
octch	и	d7
	нтж	ch
	пе	octend
	сч	num
	сда	64-3
	или	ch
	пб	octlp
octend	сч	num
	пб	(М14)
*
* Печать шапки.
begin	уиа	tvers(М1)
	пв	type(М15)
	пе	prompt
*
* Главный цикл: приглашение и ввод строки в ans; пустая строка - снова
* шапка. Первые три буквы - в word.
prompt	уиа	ans(М1)
	уиа	4(М16)
	сч	tprmt
	зп	(М1)
	мода	
	пв	input(М15)
	по	begin
	уиа	40(М2)
	уиа	-2(М3)
rdcmd	мода	
	пв	getc(М15)
	сч	word
	сда	64-8
	или	ch
	зп	word
	цикл	rdcmd(М3)
	сч	
	зп	yparm
	зп	rq
	уиа	1(М10)
	уиа	(М7)
*
* Поиск директивы: М10 - её номер, М7 - число директив с ответом (E47)
* перед ней, то есть номер в rtab.
fndcmd	сч	cmdtab-1(М10)
	по	nocmd
	нтж	word
	и	msk24
	по	found
	сч	cmdtab-1(М10)
	и	E47
	по	fndnxt
	слиа	1(М7)
fndnxt	цикл	fndcmd(М10)
*
* Не нашли: КОН - конец (finish), иначе НЕТ ДИРЕК.
nocmd	сч	word
	нтж	tkon
	и	msk24
	по	finish
	уиа	tnocmd(М1)
	пб	say
tnocmd	конд	п'НЕТ ДИ'
	конд	п'РЕК   '
	конд	м40в'377'м32в'377'м24в'377'м16в'377'м8в'377'в'377'
*
* Нашли. E48 - имени нет: пропустить остаток слова (skpwrd). Иначе
* пропустить остаток слова до пробела, ':' или конца; после пробела -
* имя до ':' или конца (rdname, E4 в rq).
found	сч	
	зп	star
	сч	cmdtab-1(М10)
	и	E48
	пе	skpwrd
skpnm	мода	
	пв	getc(М15)
	нтж	eol
	по	setcod
	нтж	d340
	по	setcod
	нтж	d20
	пе	skpnm
	уиа	-40(М4)
	уиа	rqname(М3)
rdname	мода	
	пв	getc(М15)
	нтж	eol
	по	endnam
	нтж	d340
	по	endnam
	сч	E4
	или	rq
	зп	rq
	сч	ch
	уиа	rdname(М15)
	пб	putc
endnam	сч	eol
	пв	putc(М15)
	пб	setcod
skpwrd	сч	ch
	нтж	eol
	по	setcod
	пв	getc(М15)
	сч	ch
	нтж	space
	по	setcod
	сч	ch
	нтж	colon
	по	setcod
	пб	skpwrd
*
* Номер директивы в разряды 48-43 rq (с 27-й - плюс 22).
setcod	уии	М16(М10)
	слиа	-27(М16)
	счи	М16
	и	E15
	пе	setlow
	слиа	49(М16)
	счи	М16
	сда	64-42
	или	rq
	зп	rq
	пб	parlp
setlow	счи	М10
	сда	64-42
	или	rq
	зп	rq
*
* Разбор параметров. Пробелы пропускаются, '*' - star, конец строки -
* выполнение (exec). Ключ - первая буква, до '=' или ':'; запятая или
* конец раньше - ошибка.
parlp	сч	ch
	нтж	eol
	по	exec
	пв	getc(М15)
	зп	word
	зп	keych
	нтж	space
	по	getc
	сч	ch
	нтж	aster
	по	setstr
	сч	ch
	нтж	eol
	по	exec
	мода	
	пв	getc(М15)
	нтж	eol
	по	keyerr
	сч	ch
	нтж	equal
	по	keyfnd
	сч	ch
	нтж	colon
	по	keyfnd
	сч	ch
	нтж	comma
	пе	getc
*
* Ошибка в ключе: <ключ> - ОШИБКА !, снова приглашение.
keyerr	сч	keych
	или	tkeysf
	зп	tkeyer
	уиа	tkeyer(М1)
	пб	say
tkeyer	пам	1
	конд	п' - ОШИ'
	конд	п'БКА !0'в'377'
setstr	сч	E1
	зп	star
	пб	parlp
*
* Поиск ключа в keytab (М15 - номер с 1, М11 = 25 - М15); разряд 25+k
* слова директивы должен разрешать ключ.
keyfnd	уиа	24(М11)
	уиа	1(М15)
keylp	сч	keytab-1(М15)
	по	keyerr
	нтж	word
	и	eol
	по	keychk
	слиа	-1(М11)
	цикл	keylp(М15)
keychk	сч	E48
	сда	64-1(М11)
	и	cmdtab-1(М10)
	пе	keytab-1(М15)
	пб	keyerr
*
* Ошибка в значении: ОШИБКА В ПАРАМ. <ключ>, снова приглашение.
valerr	сч	keych
	или	tkeysf
	зп	valkey
	уиа	tvaler(М1)
	пб	say
tvaler	конд	п'ОШИБКА'
	конд	п' В ПАР'
	конд	п'АМ.000'м16в'154'м8в'143'в'143'
valkey	пам	1
	конд	в'-1'
*
* bcdnum: шесть символов с кодами 0-017 по 4 разряда (шифр), результат
* в разрядах 24-1 A; возврат по М5.
bcdnum	уиа	-5(М16)
	сч	
	зп	word
bcdlp	мода	
	пв	getc(М15)
	и	space
	нтж	ch
	пе	valerr
	сч	word
	сда	64-4
	или	ch
	зп	word
	цикл	bcdlp(М16)
	пб	(М5)
*
* decnum: двоично-десятичное число из разрядов 16-1 A (четыре тетрады)
* в двоичное (умножение на 10); возврат по М15.
decnum	сда	64-32
	зп	word
	уиа	-3(М16)
	сч	
declp	зп	dctmp
	сч	word
	сда	64-4
	зп	word
	счмр	
	зп	dcres
	сч	dctmp
	умн	d10
	счмр	64
	слц	dcres
	цикл	declp(М16)
