	сч	pg02(М17)
	сда	64-16
	рзб	cwmsk
	или	wrcw2
	зп	wrcw2
	Э70	wrcw2
	сч	wrcw1
	сда	64+30
	сда	64-10
	уи	М16
	сч	
	пб	(М15)
