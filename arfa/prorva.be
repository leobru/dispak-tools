	пв	getc(М16)
	нтж	cend
	по	clrpg
	сч	char
	нтж	cslash
	по	parnum
	сч	char
	мода	w2
	уиа	(М14)
	мода	(М1)
	уиа	(М15)
	мода	
	пв	putc(М16)
parnxt	пб	parnam
parnum	мода	w1
	уиа	(М14)
	мода	pg02+1
	уиа	(М15)
	мода	
	пв	getc(М16)
pardel	нтж	ccomma
	по	parend
	сч	char
	нтж	cend
	пе	pardig
