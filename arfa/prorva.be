**********
* Чтение в страницу М16 куска каталога, заданного словом pg02(М17) ККУС:
* его разряды 48-33 (номер зоны) раскладываются по маске cwmsk в
* управляющее слово Э70; привод - на сумматоре. Разряды 16-1 - ключ.
* Если слово 0 страницы уже совпадает со словом ККУС (разряды 32-1),
* чтения нет. Выход: сумматор = 0, если ключ зоны совпал. Возврат
* по М15.
rdkey	зп	rdcw
	сч	pg02(М17)
	нтж	(М16)
	сда	64-16
	по	(М15)
	сч	pg02(М17)
	рзб	cwmsk
	или	E40
	или	rdcw
	зп	rdcw
	счи	М16
	сда	64+10
	сда	64-30
	или	rdcw
	зп	rdcw
	Э70	rdcw
	сч	rdcw
	сда	64+30
	сда	64-10
	уи	М16
	сч	(М16)
	нтж	pg02(М17)
	сда	64-16
	пб	(М15)
wrcw1	пам	1
wrcw2	пам	1
**********
